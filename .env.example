# Copy to .env.local and fill in what you have.
# The app runs and every flow works end-to-end with none of these set —
# missing integrations degrade gracefully (heuristic keyword extraction,
# empty results for that source, CRM sync skipped/logged locally).

# Claude — creative brief parsing. Without this, a local heuristic keyword
# extractor is used instead.
ANTHROPIC_API_KEY=

# Unsplash — stock photo search. Get a free key at unsplash.com/developers.
UNSPLASH_ACCESS_KEY=

# Pexels — stock photo search. Get a free key at pexels.com/api.
PEXELS_API_KEY=

# Baseten — hosted FLUX/Stable Diffusion model for custom AI tile generation.
# BASETEN_MODEL_URL is the specific deployed model's predict endpoint,
# e.g. https://model-xxxxxxx.api.baseten.co/environments/production/predict
# NOTE: a model scaled to zero can take minutes to cold-start on its first
# call after idling; the aggregator treats a slow/failed call as "no tile"
# rather than blocking the rest of the board.
BASETEN_API_KEY=
BASETEN_MODEL_URL=

# Nimble — web search/discovery for imagery beyond stock platforms.
# NIMBLE_API_URL defaults to https://api.webit.live/api/v1/realtime/serp
# if unset; override if your account's pipeline uses a different endpoint.
# NIMBLE_ACCOUNT_ID is optional — set it only if your dashboard issued a
# separate account id for Basic auth; a single token alone is sent as a
# Bearer token, which is what most Nimble accounts issue.
# NOTE: the "google_images" search_engine (the one used here) returned 500s
# ("can't download the query response") when this was last tested, while
# "isn't supported" is the error for a genuinely invalid engine name — so
# this is a recognized engine that likely needs enabling on the Nimble
# dashboard/plan, not a wrong parameter. Until then this source returns no
# tiles, which the aggregator already handles gracefully.
NIMBLE_API_KEY=
NIMBLE_ACCOUNT_ID=
NIMBLE_API_URL=

# Salesforce — logs each generated board to a Mood_Board__c record.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_TOKEN=
