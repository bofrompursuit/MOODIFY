# Copy to .env.local and fill in what you have.
# The app runs and every flow works end-to-end with none of these set —
# missing integrations degrade gracefully (heuristic keyword extraction,
# empty results for that source, CRM sync skipped/logged locally).

# Claude — creative brief parsing. Without this, a local heuristic keyword
# extractor is used instead.
ANTHROPIC_API_KEY=

# Unsplash — stock photo search. Get a free key at unsplash.com/developers.
UNSPLASH_ACCESS_KEY=

# Pexels — stock photo search. Get a free key at pexels.com/api.
PEXELS_API_KEY=

# Baseten — hosted FLUX/Stable Diffusion model for custom AI tile generation.
# BASETEN_MODEL_URL is the specific deployed model's predict endpoint,
# e.g. https://model-xxxxxxx.api.baseten.co/production/predict
BASETEN_API_KEY=
BASETEN_MODEL_URL=

# Nimble — web search/discovery for imagery beyond stock platforms.
# NIMBLE_API_URL defaults to https://api.webit.live/api/v1/realtime/serp
# if unset; override if your account's pipeline uses a different endpoint.
NIMBLE_API_KEY=
NIMBLE_ACCOUNT_ID=
NIMBLE_API_URL=

# Salesforce — logs each generated board to a Mood_Board__c record.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_TOKEN=
